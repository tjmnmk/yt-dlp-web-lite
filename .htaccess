# block access to partial download files (yt-dlp .part / .ytdl) and lock files
<FilesMatch "\.(part|ytdl|lock|f\d+\.(html|json))$">
    Require all denied
</FilesMatch>

# block direct access to config (contains cookies path / PO token)
<FilesMatch "^config\.php$">
    Require all denied
</FilesMatch>
